# 复制为 .env 后按需修改（仅本地开发/演示使用，禁止用于生产公网）
# cp .env.example .env

# 数据库
DB_URL=jdbc:mysql://localhost:3306/furniture_mall?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产环境务必改为随机长字符串，至少 32 位）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRE_SECONDS=86400

# CORS 允许的前端地址（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
